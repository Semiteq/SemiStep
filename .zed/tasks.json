[
  {
    "label": "Build UI",
    "command": "dotnet",
    "args": ["build", "SemiStep/SemiStep.UI/SemiStep.UI.csproj"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
  },
  {
    "label": "Build Solution",
    "command": "dotnet",
    "args": ["build", "SemiStep.slnx"],
    "cwd": "$ZED_WORKTREE_ROOT",
  },
  {
    "label": "Run UI (MBE)",
    "command": "dotnet",
    "args": ["run", "--project", "SemiStep/SemiStep.UI/SemiStep.UI.csproj", "--", "--config-dir", "$ZED_WORKTREE_ROOT/ConfigFiles/MBE", "--log-file", "$ZED_WORKTREE_ROOT/SemiStep/Artifacts/logs/semistep.log", "--logging-level", "verbose"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always",
    "use_new_terminal": true,
  },
  {
    "label": "Run UI (MOCVD)",
    "command": "dotnet",
    "args": ["run", "--project", "SemiStep/SemiStep.UI/SemiStep.UI.csproj", "--", "--config-dir", "$ZED_WORKTREE_ROOT/ConfigFiles/MOCVD", "--log-file", "$ZED_WORKTREE_ROOT/SemiStep/Artifacts/logs/semistep.log", "--logging-level", "verbose"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always",
    "use_new_terminal": true,
  },
  {
    "label": "Run UI (RIE)",
    "command": "dotnet",
    "args": ["run", "--project", "SemiStep/SemiStep.UI/SemiStep.UI.csproj", "--", "--config-dir", "$ZED_WORKTREE_ROOT/ConfigFiles/RIE", "--log-file", "$ZED_WORKTREE_ROOT/SemiStep/Artifacts/logs/semistep.log", "--logging-level", "verbose"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always",
    "use_new_terminal": true,
  },
  {
    "label": "Test All",
    "command": "dotnet",
    "args": ["test", "SemiStep/SemiStep.Tests/SemiStep.Tests.csproj"],
    "cwd": "$ZED_WORKTREE_ROOT",
  },
  {
    "label": "Test Current File",
    "command": "dotnet",
    "args": [
      "test",
      "SemiStep/SemiStep.Tests/SemiStep.Tests.csproj",
      "--filter",
      "FullyQualifiedName~$ZED_STEM",
    ],
    "cwd": "$ZED_WORKTREE_ROOT",
  },
  {
    "label": "format",
    "command": "dotnet",
    "args": ["format", "SemiStep.slnx"],
    "cwd": "$ZED_WORKTREE_ROOT",
  },
  {
    "label": "Perf Gates (explicit tests, Release)",
    "command": "dotnet",
    "args": [
      "run",
      "--project",
      "SemiStep/SemiStep.Tests/SemiStep.Tests.csproj",
      "-c",
      "Release",
      "--",
      "-explicit",
      "only",
    ],
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always",
    "use_new_terminal": true,
  },
]
