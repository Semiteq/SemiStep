<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:semi="https://irihi.tech/semi"
             x:Class="SemiStep.UI.App"
             RequestedThemeVariant="Light">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://SemiStep/Styles/ColorPalette.axaml" />
                <ResourceInclude Source="avares://SemiStep/Styles/Icons.axaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Uniform 4px rounding on interactive controls. Semi's component radius keys alias
                 SemiBorderRadiusSmall (3) via StaticResource, so the primitive cannot be retargeted;
                 the component keys are overridden directly and consumed by templates via DynamicResource. -->
            <CornerRadius x:Key="ButtonCornerRadius">4</CornerRadius>
            <CornerRadius x:Key="TextBoxDefaultCornerRadius">4</CornerRadius>
            <CornerRadius x:Key="ComboBoxSelectorCornerRadius">4</CornerRadius>
            <CornerRadius x:Key="NumericUpDownCornerRadius">4</CornerRadius>
            <CornerRadius x:Key="CheckBoxBoxCornerRadius">4</CornerRadius>
            <CornerRadius x:Key="MenuItemCornerRadius">4</CornerRadius>

            <!-- Kill Semi's row pointer-over "halo": its DataGridRow template paints an inset, rounded
                 Border#BackgroundBorder with DataGridRowPointeroverBackground. The app paints cell
                 backgrounds itself, so flatten the row corner radius to 0 (brushes neutralized in the
                 Light ThemeDictionary below). -->
            <CornerRadius x:Key="DataGridRowCornerRadius">0</CornerRadius>

            <!-- JetBrains Int UI (Light) retint through Semi's component keys; the mechanism is in
                 docs/architecture/grid-style-configuration.md. SemiColorText0, SemiColorText2 and
                 SemiColorBorder stay because SemiStep's own setters and the DataGrid theme read them;
                 SemiColorPrimary stays because the ColorPicker theme reads it for its tab and RGB/HSV
                 accent. ThemeTests reads each chrome color key back from a realised control. -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="SemiColorPrimary" Color="#3574F0" />
                    <SolidColorBrush x:Key="SemiColorText0" Color="#000000" />
                    <SolidColorBrush x:Key="SemiColorText2" Color="#6C707E" />
                    <SolidColorBrush x:Key="SemiColorBorder" Color="#EBECF0" />

                    <SolidColorBrush x:Key="TextBlockDefaultForeground" Color="#000000" />
                    <SolidColorBrush x:Key="WindowDefaultForeground" Color="#000000" />
                    <SolidColorBrush x:Key="TextBoxForeground" Color="#000000" />
                    <SolidColorBrush x:Key="CheckBoxForeground" Color="#000000" />
                    <SolidColorBrush x:Key="MenuItemForeground" Color="#000000" />
                    <SolidColorBrush x:Key="MenuItemPointeroverForeground" Color="#000000" />
                    <SolidColorBrush x:Key="MenuItemInputGestureTextForeground" Color="#6C707E" />
                    <SolidColorBrush x:Key="TextBoxPlaceholderForeground" Color="#6C707E" />
                    <SolidColorBrush x:Key="TextBlockDisabledForeground" Color="#A8ADBD" />
                    <SolidColorBrush x:Key="ButtonDefaultDisabledForeground" Color="#A8ADBD" />
                    <SolidColorBrush x:Key="TextBoxDisabledForeground" Color="#A8ADBD" />
                    <SolidColorBrush x:Key="CheckBoxDisabledForeground" Color="#A8ADBD" />
                    <SolidColorBrush x:Key="MenuItemDisabledForeground" Color="#A8ADBD" />
                    <SolidColorBrush x:Key="MenuItemDisabledInputGestureTextForeground" Color="#A8ADBD" />

                    <SolidColorBrush x:Key="ButtonDefaultPrimaryForeground" Color="#3574F0" />
                    <SolidColorBrush x:Key="ButtonSolidPrimaryBackground" Color="#3574F0" />
                    <SolidColorBrush x:Key="ButtonSolidPrimaryBorderBrush" Color="#3574F0" />
                    <SolidColorBrush x:Key="TextBoxFocusBorderBrush" Color="#3574F0" />
                    <SolidColorBrush x:Key="CheckBoxCheckedDefaultBackground" Color="#3574F0" />
                    <SolidColorBrush x:Key="CheckBoxCheckedDefaultBorderBrush" Color="#3574F0" />
                    <SolidColorBrush x:Key="CheckBoxPointeroverBorderBrush" Color="#3574F0" />
                    <SolidColorBrush x:Key="ButtonSolidPrimaryPointeroverBackground" Color="#3369D6" />
                    <SolidColorBrush x:Key="ButtonSolidPrimaryPointeroverBorderBrush" Color="#3369D6" />
                    <SolidColorBrush x:Key="CheckBoxCheckedPointeroverBackground" Color="#3369D6" />
                    <SolidColorBrush x:Key="CheckBoxCheckedPointeroverBorderBrush" Color="#3369D6" />
                    <SolidColorBrush x:Key="ButtonSolidPrimaryPressedBackground" Color="#315FBD" />
                    <SolidColorBrush x:Key="ButtonSolidPrimaryPressedBorderBrush" Color="#315FBD" />
                    <SolidColorBrush x:Key="CheckBoxCheckedPressedBackground" Color="#315FBD" />
                    <SolidColorBrush x:Key="CheckBoxCheckedPressedBorderBrush" Color="#315FBD" />
                    <SolidColorBrush x:Key="CheckBoxPressedBorderBrush" Color="#315FBD" />

                    <!-- Neutralize Semi's row pointer-over highlight (the inset "halo"). Selection is
                         painted at cell level by CellPaletteInstaller, so the selected-on-hover variant
                         can also go transparent without losing the selection look. -->
                    <SolidColorBrush x:Key="DataGridRowPointeroverBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="DataGridRowSelectedPointeroverBackground" Color="Transparent" />

                    <!-- Black frame on the current/focused cell. Semi draws the CurrencyVisual/FocusVisual
                         rectangles (Stroke = DataGridCellCurrentBorderBrush / DataGridCellFocusBorderBrush)
                         in a light brush that does not read; retint black. -->
                    <SolidColorBrush x:Key="DataGridCellCurrentBorderBrush" Color="#000000" />
                    <SolidColorBrush x:Key="DataGridCellFocusBorderBrush" Color="#000000" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
    <Application.Styles>
        <semi:SemiTheme />
        <semi:ColorPickerSemiTheme />
        <semi:DataGridSemiTheme />
        <!-- Chrome input density. Placed before the DataGrid style include so DataGrid cell ComboBoxes
             keep their own padding (set in DataGridStyles.axaml) under last-match-wins. -->
        <Style Selector="ComboBox, NumericUpDown, TextBox">
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="Padding" Value="8,3" />
        </Style>
        <StyleInclude Source="avares://SemiStep/Styles/DataGridStyles.axaml" />
        <StyleInclude Source="avares://SemiStep/Styles/Buttons.axaml" />
        <Style Selector="Window">
            <Setter Property="FontFamily" Value="{DynamicResource ChromeFontFamily}" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </Application.Styles>
</Application>
