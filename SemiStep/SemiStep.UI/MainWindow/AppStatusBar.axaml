<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:SemiStep.UI.MainWindow"
             mc:Ignorable="d"
             x:Class="SemiStep.UI.MainWindow.AppStatusBar"
             x:DataType="local:MainWindowViewModel">

    <UserControl.Styles>
        <Style Selector="Button.sync-toggle">
            <Setter Property="Theme" Value="{StaticResource {x:Type Button}}" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#33000000" />
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="MinWidth" Value="76" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style Selector="Button.sync-toggle.sync-local">
            <Setter Property="Background" Value="{DynamicResource LocalModeBrush}" />
        </Style>
        <Style Selector="Button.sync-toggle.sync-nolink">
            <Setter Property="Background" Value="{DynamicResource DisconnectedBrush}" />
        </Style>
        <Style Selector="Button.sync-toggle.sync-linked">
            <Setter Property="Background" Value="{DynamicResource ConnectedBrush}" />
        </Style>

        <!-- Hold the state color on hover; the generic :pressed scrim below darkens the press -->
        <Style Selector="Button.sync-toggle.sync-local:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource LocalModeBrush}" />
        </Style>
        <Style Selector="Button.sync-toggle.sync-nolink:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource DisconnectedBrush}" />
        </Style>
        <Style Selector="Button.sync-toggle.sync-linked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ConnectedBrush}" />
        </Style>
        <Style Selector="Button.sync-toggle:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#22000000" />
        </Style>
    </UserControl.Styles>

    <Border Name="StatusBarBorder"
            Background="{DynamicResource StatusBarBackgroundBrush}"
            BorderBrush="{DynamicResource SubtleBorderBrush}"
            BorderThickness="0,1,0,0"
            TextElement.Foreground="{DynamicResource StatusBarForegroundBrush}"
            TextElement.FontFamily="{DynamicResource AppFontFamily}"
            TextElement.FontSize="{DynamicResource StatusBarFontSize}"
            TextElement.FontWeight="{DynamicResource StatusBarFontWeight}"
            TextElement.FontStyle="{DynamicResource StatusBarFontStyle}"
            Padding="{DynamicResource StatusBarPadding}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Error/Warning counts - clickable to toggle log panel -->
            <Button Grid.Column="0"
                    Command="{Binding MessagePanel.ToggleCommand}"
                    IsVisible="{Binding MessagePanel.HasStatusErrors}"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="4,2"
                    VerticalAlignment="Center"
                    Cursor="Hand">
                <StackPanel Orientation="Horizontal" Spacing="{DynamicResource StatusBarItemSpacing}">
                    <!-- Error count -->
                    <StackPanel Orientation="Horizontal"
                                Spacing="4"
                                IsVisible="{Binding MessagePanel.HasErrors}">
                        <Ellipse Width="8" Height="8"
                                 Fill="{DynamicResource ErrorBrush}"
                                 VerticalAlignment="Center" />
                        <TextBlock Text="{Binding MessagePanel.ErrorCountText}"
                                   Foreground="{DynamicResource ErrorBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Warning count -->
                    <StackPanel Orientation="Horizontal"
                                Spacing="4"
                                IsVisible="{Binding MessagePanel.HasWarnings}">
                        <Ellipse Width="8" Height="8"
                                 Fill="{DynamicResource WarningBrush}"
                                 VerticalAlignment="Center" />
                        <TextBlock Text="{Binding MessagePanel.WarningCountText}"
                                   Foreground="{DynamicResource WarningBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Button>

            <!-- Separator (only if errors visible) -->
            <Border Grid.Column="1"
                    Width="1"
                    Background="{DynamicResource SeparatorBrush}"
                    Margin="12,2"
                    IsVisible="{Binding MessagePanel.HasStatusErrors}" />

            <!-- Sync controls -->
            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        Spacing="6"
                        VerticalAlignment="Center">

                <!-- Merged sync/connection toggle: fill color encodes IsSyncEnabled + IsConnectedToPlc -->
                <Button Command="{Binding ToggleSyncCommand}"
                        Classes="sync-toggle"
                        Classes.sync-local="{Binding IsSyncLocalMode}"
                        Classes.sync-nolink="{Binding IsSyncNoLink}"
                        Classes.sync-linked="{Binding IsSyncLinked}">
                    <Panel>
                        <TextBlock Text="Sync ON"
                                   IsVisible="{Binding IsSyncEnabled}" />
                        <TextBlock Text="Sync OFF"
                                   IsVisible="{Binding IsSyncEnabled, Converter={x:Static BoolConverters.Not}}" />
                    </Panel>
                </Button>

                <!-- Sync status label -->
                <TextBlock Text="{Binding PlcSyncStatusText}"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource SecondaryForegroundBrush}" />

                <!-- Last sync time -->
                <TextBlock VerticalAlignment="Center"
                           Foreground="{DynamicResource SecondaryForegroundBrush}"
                           Text="{Binding LastSyncTimeText, StringFormat='Last sync: {0}'}" />

            </StackPanel>

            <!-- Separator before execution info -->
            <Border Grid.Column="3"
                    Width="1"
                    Background="{DynamicResource SeparatorBrush}"
                    Margin="12,2" />

            <!-- Execution time info (always visible; VM maps idle state via text content) -->
            <StackPanel Grid.Column="4"
                        Orientation="Horizontal"
                        Spacing="{DynamicResource StatusBarItemSpacing}"
                        VerticalAlignment="Center">

                <!-- Time left in current step -->
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="Шаг:"
                               Foreground="{DynamicResource SecondaryForegroundBrush}"
                               FontSize="{DynamicResource StatusBarTimerLabelFontSize}"
                               FontWeight="{DynamicResource StatusBarTimerLabelFontWeight}"
                               FontStyle="{DynamicResource StatusBarTimerLabelFontStyle}"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{Binding PlcMonitor.TimeLeftInStepText}"
                               FontSize="{DynamicResource StatusBarTimerValueFontSize}"
                               FontWeight="{DynamicResource StatusBarTimerValueFontWeight}"
                               FontStyle="{DynamicResource StatusBarTimerValueFontStyle}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <!-- Time left in recipe -->
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="Рецепт:"
                               Foreground="{DynamicResource SecondaryForegroundBrush}"
                               FontSize="{DynamicResource StatusBarTimerLabelFontSize}"
                               FontWeight="{DynamicResource StatusBarTimerLabelFontWeight}"
                               FontStyle="{DynamicResource StatusBarTimerLabelFontStyle}"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{Binding PlcMonitor.TimeLeftInRecipeText}"
                               FontSize="{DynamicResource StatusBarTimerValueFontSize}"
                               FontWeight="{DynamicResource StatusBarTimerValueFontWeight}"
                               FontStyle="{DynamicResource StatusBarTimerValueFontStyle}"
                               VerticalAlignment="Center" />
                </StackPanel>

            </StackPanel>

            <!-- Separator before FOR loop counters -->
            <Border Grid.Column="5"
                    Width="1"
                    Background="{DynamicResource SeparatorBrush}"
                    Margin="12,2"
                    IsVisible="{Binding PlcMonitor.IsRecipeActive}" />

            <!-- FOR loop counters (visible only when recipe is active) -->
            <StackPanel Grid.Column="6"
                        Orientation="Horizontal"
                        Spacing="8"
                        VerticalAlignment="Center"
                        IsVisible="{Binding PlcMonitor.IsRecipeActive}">

                <TextBlock Text="FOR:"
                           Foreground="{DynamicResource SecondaryForegroundBrush}"
                           VerticalAlignment="Center" />

                <TextBlock Text="{Binding PlcMonitor.ForLoopCount1}"
                           VerticalAlignment="Center" />

                <TextBlock Text="{Binding PlcMonitor.ForLoopCount2}"
                           VerticalAlignment="Center" />

                <TextBlock Text="{Binding PlcMonitor.ForLoopCount3}"
                           VerticalAlignment="Center" />

            </StackPanel>

        </Grid>
    </Border>

</UserControl>
