<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:SemiStep.UI.MainWindow"
             xmlns:l="clr-namespace:SemiStep.UI.Localization"
             mc:Ignorable="d"
             x:Class="SemiStep.UI.MainWindow.AppStatusBar"
             x:DataType="local:MainWindowViewModel">

    <UserControl.Styles>
        <Style Selector="Button.status-slot">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource StatusBarForegroundBrush}" />
            <!-- The Button theme sets its own font; a slot text keeps the bar's. -->
            <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
            <Setter Property="FontSize" Value="{DynamicResource StatusBarFontSize}" />
            <Setter Property="FontWeight" Value="{DynamicResource StatusBarFontWeight}" />
            <Setter Property="FontStyle" Value="{DynamicResource StatusBarFontStyle}" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.status-slot:pointerover /template/ ContentPresenter, Button.status-slot:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Border.status-separator">
            <Setter Property="Width" Value="1" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource SeparatorBrush}" />
        </Style>
    </UserControl.Styles>

    <!-- Fixed-width slots: no item moves when a text changes. -->
    <Border Name="StatusBarBorder"
            MinHeight="38"
            Background="{DynamicResource StatusBarBackgroundBrush}"
            BorderBrush="{DynamicResource SubtleBorderBrush}"
            BorderThickness="0,1,0,0"
            TextElement.Foreground="{DynamicResource StatusBarForegroundBrush}"
            TextElement.FontFamily="{DynamicResource AppFontFamily}"
            TextElement.FontSize="{DynamicResource StatusBarFontSize}"
            TextElement.FontWeight="{DynamicResource StatusBarFontWeight}"
            TextElement.FontStyle="{DynamicResource StatusBarFontStyle}"
            TextElement.FontFeatures="+tnum"
            Padding="{DynamicResource StatusBarPadding}">
        <Grid Name="SlotRow" ColumnDefinitions="12,270,25,200,8,190,25,134,8,154,*,80,12">

            <Button Name="LinkSlot"
                    Grid.Column="1"
                    Width="270"
                    Classes="status-slot"
                    HorizontalContentAlignment="Stretch"
                    Command="{Binding MessagePanel.ShowCommand}"
                    ToolTip.Tip="{Binding PlcLink.View.ToolTip}">
                <Grid ColumnDefinitions="12,*">
                    <Panel Width="8" Height="8" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Ellipse Fill="{DynamicResource ConnectedBrush}"
                                 IsVisible="{Binding PlcLink.View.IsGreenDot}" />
                        <Ellipse Fill="{DynamicResource DisconnectedBrush}"
                                 IsVisible="{Binding PlcLink.View.IsRedDot}" />
                        <Ellipse Stroke="{DynamicResource SecondaryForegroundBrush}"
                                 StrokeThickness="1"
                                 IsVisible="{Binding PlcLink.View.IsHollowDot}" />
                    </Panel>
                    <TextBlock Name="LinkText"
                               Grid.Column="1"
                               VerticalAlignment="Center"
                               Text="{Binding PlcLink.View.Text}" />
                </Grid>
            </Button>

            <Border Grid.Column="2" Classes="status-separator" />

            <Grid Name="StateStepSlot"
                  Grid.Column="3"
                  Width="200"
                  ColumnDefinitions="20,*"
                  Background="Transparent"
                  ToolTip.Tip="{Binding PlcMonitor.ExecutionToolTip}">
                <PathIcon Name="LockGlyph"
                          Width="16"
                          Height="16"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Center"
                          Data="{StaticResource LockGeometry}"
                          Foreground="{DynamicResource SecondaryForegroundBrush}"
                          IsVisible="{Binding PlcMonitor.IsRecipeActive}" />
                <TextBlock Name="StateStepText"
                           Grid.Column="1"
                           VerticalAlignment="Center"
                           Text="{Binding PlcMonitor.StateStepText}" />
            </Grid>

            <Panel Name="LoopSlot"
                   Grid.Column="5"
                   Width="190"
                   Background="Transparent"
                   ToolTip.Tip="{Binding PlcMonitor.ExecutionToolTip}">
                <TextBlock Name="LoopText"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Text="{Binding PlcMonitor.LoopText}" />
            </Panel>

            <Border Grid.Column="6" Classes="status-separator" />

            <StackPanel Name="StepTimerSlot"
                        Grid.Column="7"
                        Width="134"
                        Orientation="Horizontal"
                        Spacing="4"
                        VerticalAlignment="Center">
                <TextBlock Text="{Binding PlcMonitor.TimeLeftInStepCaption}"
                           Foreground="{DynamicResource SecondaryForegroundBrush}" />
                <TextBlock Text="{Binding PlcMonitor.TimeLeftInStepText}" />
            </StackPanel>

            <StackPanel Name="RecipeTimerSlot"
                        Grid.Column="9"
                        Width="154"
                        Orientation="Horizontal"
                        Spacing="4"
                        VerticalAlignment="Center">
                <TextBlock Text="{Binding PlcMonitor.TimeLeftInRecipeCaption}"
                           Foreground="{DynamicResource SecondaryForegroundBrush}" />
                <TextBlock Text="{Binding PlcMonitor.TimeLeftInRecipeText}" />
            </StackPanel>

            <Button Name="CountsSlot"
                    Grid.Column="11"
                    Width="80"
                    Classes="status-slot"
                    HorizontalContentAlignment="Stretch"
                    Command="{Binding MessagePanel.ToggleCommand}"
                    IsHitTestVisible="{Binding MessagePanel.HasStatusErrors}"
                    ToolTip.Tip="{Binding MessagePanel.StatusErrorSummary}">
                <!-- One fixed column per count: neither dot moves when a count changes width. -->
                <Grid ColumnDefinitions="40,40">
                    <StackPanel Orientation="Horizontal"
                                Spacing="4"
                                IsVisible="{Binding MessagePanel.HasErrors}">
                        <Ellipse Name="ErrorDot"
                                 Width="8" Height="8"
                                 Fill="{DynamicResource ErrorBrush}"
                                 VerticalAlignment="Center" />
                        <TextBlock Text="{Binding MessagePanel.ErrorCount}" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="4"
                                IsVisible="{Binding MessagePanel.HasWarnings}">
                        <Ellipse Name="WarningDot"
                                 Width="8" Height="8"
                                 Fill="{DynamicResource WarningBrush}"
                                 VerticalAlignment="Center" />
                        <TextBlock Text="{Binding MessagePanel.WarningCount}" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Button>

        </Grid>
    </Border>

</UserControl>
