<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:messageService="clr-namespace:SemiStep.UI.MessageService"
             xmlns:l="clr-namespace:SemiStep.UI.Localization"
             mc:Ignorable="d"
             x:Class="SemiStep.UI.MessageService.MessagePanel"
             x:DataType="messageService:MessagePanelViewModel">

    <UserControl.Styles>
        <!-- Severity dot colors via style class binding -->
        <Style Selector="Ellipse.severity-dot.error">
            <Setter Property="Fill" Value="{DynamicResource ErrorBrush}" />
        </Style>
        <Style Selector="Ellipse.severity-dot.warning">
            <Setter Property="Fill" Value="{DynamicResource WarningBrush}" />
        </Style>
        <Style Selector="Ellipse.severity-dot:not(.error):not(.warning)">
            <Setter Property="Fill" Value="{DynamicResource SubtleBorderBrush}" />
        </Style>
    </UserControl.Styles>

    <Border Background="{DynamicResource ValidationPanelBackgroundBrush}"
            BorderBrush="{DynamicResource SubtleBorderBrush}"
            BorderThickness="0,1,0,0"
            TextElement.Foreground="{DynamicResource ValidationPanelForegroundBrush}"
            MaxHeight="{DynamicResource ValidationPanelMaxHeight}">

        <Grid RowDefinitions="Auto,*">

            <!-- Header with counts and close button -->
            <Border Grid.Row="0"
                    Background="{DynamicResource PanelHeaderBackgroundBrush}"
                    Padding="8,4">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                Spacing="12"
                                VerticalAlignment="Center">

                        <!-- Error count -->
                        <StackPanel Orientation="Horizontal"
                                    Spacing="4"
                                    IsVisible="{Binding HasErrors}">
                            <Ellipse Width="8" Height="8"
                                     Fill="{DynamicResource ErrorBrush}"
                                     VerticalAlignment="Center" />
                            <TextBlock Text="{Binding ErrorCountText}"
                                       FontSize="12"
                                       Foreground="{DynamicResource ErrorBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- Warning count -->
                        <StackPanel Orientation="Horizontal"
                                    Spacing="4"
                                    IsVisible="{Binding HasWarnings}">
                            <Ellipse Width="8" Height="8"
                                     Fill="{DynamicResource WarningBrush}"
                                     VerticalAlignment="Center" />
                            <TextBlock Text="{Binding WarningCountText}"
                                       FontSize="12"
                                       Foreground="{DynamicResource WarningBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                    </StackPanel>

                    <Button x:Name="CloseButton"
                            Grid.Column="1"
                            Command="{Binding ToggleCommand}"
                            ToolTip.Tip="{x:Static l:Resources.MessagePanelClose}"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            Padding="6,2"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                        <TextBlock Text="✕"
                                   FontSize="12"
                                   VerticalAlignment="Center" />
                    </Button>

                </Grid>
            </Border>

            <!-- Log entries list -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Entries}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="messageService:MessageEntry">
                            <Border Padding="8,3"
                                    BorderBrush="{DynamicResource GridLineBrush}"
                                    BorderThickness="0,0,0,1">
                                <Grid ColumnDefinitions="16,*">

                                    <!-- Severity dot (style class binding) -->
                                    <Ellipse Grid.Column="0"
                                             Width="8" Height="8"
                                             Classes="severity-dot"
                                             Classes.error="{Binding IsError}"
                                             Classes.warning="{Binding IsWarning}"
                                             VerticalAlignment="Center"
                                             HorizontalAlignment="Center" />

                                    <!-- Message -->
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Message}"
                                               FontSize="12"
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Center" />

                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

        </Grid>
    </Border>

</UserControl>
