<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:rg="clr-namespace:SemiStep.UI.RecipeGrid;assembly=SemiStep">

    <!-- The transposed grid moves keyboard focus between display cells, so the focused combo cell shows its
         chevron (hover and the disabled rule live in DataGridStyles.axaml). -->
    <Style Selector="rg|LazyComboCellPresenter:focus:not(:disabled) Path.cell-chevron">
        <Setter Property="IsVisible" Value="True" />
    </Style>

    <!-- Transposed recipe grid (ListBox of step columns). Each cell's background is a local
         CellBackgroundConverter MultiBinding (TransposedColumnCellsPresenter) that outranks style
         setters, so no background setters for cells live here. -->

    <!-- Focus frame on the focused editable cell: an inset shadow in the selection accent, so the cell keeps
         its size. Read-only cells hold no focusable presenter and never show it. -->
    <Style Selector=":is(rg|LazyCellPresenter):focus">
        <Setter Property="BoxShadow" Value="{DynamicResource CellFocusFrame}" />
    </Style>

    <!-- Container reset: the grid paints its own cell chrome, so the ListBox and its item
         containers must contribute no padding, radius, or state background of their own. -->
    <Style Selector="ListBox.transposed-grid">
        <Setter Property="Background" Value="{DynamicResource GridBackgroundBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="ListBox.transposed-grid ListBoxItem">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="VerticalAlignment" Value="Top" />
    </Style>
    <Style Selector="ListBox.transposed-grid ListBoxItem:pointerover, ListBox.transposed-grid ListBoxItem:selected, ListBox.transposed-grid ListBoxItem:selected:pointerover">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <!-- Parameter-name column and step-number header: the transposed analogs of canonical's
         column headers and numbering column. -->
    <Style Selector="Border.transposed-header-spacer, Border.transposed-name-cell, Border.transposed-step-header">
        <Setter Property="Background" Value="{DynamicResource GridBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource GridLineBrush}" />
        <Setter Property="BorderThickness" Value="0,0,1,1" />
    </Style>
    <Style Selector="Border.transposed-header-spacer, Border.transposed-name-cell, Border.transposed-step-header">
        <Setter Property="TextElement.Foreground" Value="{DynamicResource HeaderForegroundBrush}" />
    </Style>
    <!-- The running and stop step headers carry the run glyph; the whole label is black, as in the canonical № cell. -->
    <Style Selector="Border.transposed-step-header TextBlock.running, Border.transposed-step-header TextBlock.stopped">
        <Setter Property="Foreground" Value="{DynamicResource SemiColorText0}" />
    </Style>

    <!-- Base cell chrome. Background is the CellBackgroundConverter MultiBinding set in
         the view; the border thickness is set in code (TransposedColumnCellsPresenter.GridLineWidth),
         so the step column width can reserve it. All cell text is black in every state, so the
         cell does not inherit the ListBoxItem foreground. -->
    <Style Selector="Border.transposed-cell">
        <Setter Property="BorderBrush" Value="{DynamicResource GridLineBrush}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource SemiColorText0}" />
    </Style>

</Styles>
